# STOCKZ environment — two distinct uses, one example file.
#
# SERVER (production): copy to .env NEXT TO docker-compose.yml on the host. Only the
# backend login lives there. Until it exists the desk boots LOCKED, never open.
#
# LOCAL DEV: copy to .env.local and fill the venue keys for `npm run dev` adoption.
# .env / .env.local are gitignored. NEVER commit real values.

# ── backend login (server-side .env) ─────────────────────────────────────────
# The two accounts. usr = paper trading only; admin = the full desk including live.
STOCKZ_USER_PASSWORD=
STOCKZ_ADMIN_PASSWORD=
# Signs the session cookies (any long random string, e.g. `openssl rand -base64 32`).
# Optional: unset means a fresh secret per boot, i.e. everyone re-logs in on restart.
STOCKZ_SESSION_SECRET=

# ── venue keys ───────────────────────────────────────────────────────────────
# The server's .env IS the key store (owner decision, single-user desk): the backend
# hands these to a signed-in ADMIN session at boot and the desk loads them into its
# in-memory vault — no modal, no URL params needed. `usr` (paper) never receives them.
# The same names work in .env.local for `npm run dev` adoption.

# OKX (crypto)
STOCKZ_OKX_API_KEY=
STOCKZ_OKX_SECRET_KEY=
STOCKZ_OKX_PASSPHRASE=

# EToro (stocks / CFD)
STOCKZ_ETORO_API_KEY=
STOCKZ_ETORO_USER_KEY=

# ── server-side trader ───────────────────────────────────────────────────────
# The trading loop runs IN THIS PROCESS, not in a browser tab. It keeps trading with
# every tab closed, the phone locked and the laptop shut — which is the whole reason it
# lives here. The dashboard is a window onto it (/api/trader), never a control for it.
#
# Two separate switches, because they are two separate decisions:
#   STOCKZ_TRADER=on         starts the loop at all       (default: off)
#   STOCKZ_TRADER_MODE=live  lets it spend money          (default: paper)
# Paper still uses the real live book and crosses the real spread; it just books the
# fill here instead of sending it. Run a session on paper before funding it.
STOCKZ_TRADER=
STOCKZ_TRADER_MODE=

# What it trades, and how much per order (base currency, e.g. BTC).
STOCKZ_TRADER_SYMBOLS=BTC-USDT
STOCKZ_TRADER_SIZE=0.001

# The limits. Orders per minute across everything, and the largest absolute position
# the loop may build in any one instrument. Both bind before an order is sent, and
# reducing a position is never blocked by the cap.
STOCKZ_TRADER_MAX_PER_MIN=120
STOCKZ_TRADER_MAX_PER_INSTRUMENT=0.01

# Trades per hour, as one dial. 0 = the four strategies exactly as shipped (tuned to
# disagree with each other, not to fire often); 1 = every threshold at its floor.
# Measured on a replayed tape: 0 -> ~54 orders, 0.5 -> ~271, 0.75 -> ~411, 1.0 -> ~735.
# Note 1.0 traded MOST and earned LEAST — past ~0.75 the extra trades pay the spread
# away. Start at 0.75.
STOCKZ_TRADER_SENSITIVITY=0.75

# The loss-streak bench: N losers in a row and the instrument sits out for M minutes.
# This, not the thresholds, is what actually caps trades-per-hour once sensitivity is
# up — a chattier loop takes more losers, hits the streak sooner, and benches itself.
# With the 3/10 defaults, sensitivity 1.0 produced FEWER orders than 0.5.
# 0 minutes means never bench.
STOCKZ_TRADER_COOLDOWN_AFTER=4
STOCKZ_TRADER_COOLDOWN_MINUTES=1

# Which OKX the KEYS above live on — the same two axes as the desk's checkboxes. Defaults
# are EU platform, live environment. Run `node scripts/okx-whoami.mjs .env` to find out.
STOCKZ_OKX_EEA=true
STOCKZ_OKX_DEMO=
