# STOCKZ local dev credentials — copy to .env.local and fill in.
# .env.local is gitignored. NEVER commit real values.
# In production the browser gets keys from URL params or the key modal instead
# (see .claude/context/integrations.md).

# OKX (crypto)
STOCKZ_OKX_API_KEY=
STOCKZ_OKX_SECRET_KEY=
STOCKZ_OKX_PASSPHRASE=

# EToro (stocks / CFD)
STOCKZ_ETORO_API_KEY=
STOCKZ_ETORO_USER_KEY=
