# STOCKZ environment — two distinct uses, one example file.
#
# SERVER (production): copy to .env NEXT TO docker-compose.yml on the host. Only the
# backend login lives there. Until it exists the desk boots LOCKED, never open.
#
# LOCAL DEV: copy to .env.local and fill the venue keys for `npm run dev` adoption.
# .env / .env.local are gitignored. NEVER commit real values.

# ── backend login (server-side .env) ─────────────────────────────────────────
# The two accounts. usr = paper trading only; admin = the full desk including live.
STOCKZ_USER_PASSWORD=
STOCKZ_ADMIN_PASSWORD=
# Signs the session cookies (any long random string, e.g. `openssl rand -base64 32`).
# Optional: unset means a fresh secret per boot, i.e. everyone re-logs in on restart.
STOCKZ_SESSION_SECRET=

# ── venue keys ───────────────────────────────────────────────────────────────
# The server's .env IS the key store (owner decision, single-user desk): the backend
# hands these to a signed-in ADMIN session at boot and the desk loads them into its
# in-memory vault — no modal, no URL params needed. `usr` (paper) never receives them.
# The same names work in .env.local for `npm run dev` adoption.

# OKX (crypto)
STOCKZ_OKX_API_KEY=
STOCKZ_OKX_SECRET_KEY=
STOCKZ_OKX_PASSPHRASE=

# EToro (stocks / CFD)
STOCKZ_ETORO_API_KEY=
STOCKZ_ETORO_USER_KEY=
